{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["client/src/*"],
      "~/*": ["client/*"]
    },
    "types": ["tailwindcss"]
  },
  "include": [
    "client/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}